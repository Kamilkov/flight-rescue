<mvc:View controllerName="fr.cockpit.Main" height="100%"
  xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:fr="fr.cockpit" xmlns:vbm="sap.ui.vbm">
  <Page enableScrolling="false">
    <customHeader>
      <Bar>
        <contentLeft>
          <core:Icon src="sap-icon://flight" decorative="true"/>
          <Title text="Flight rescue"/>
        </contentLeft>
        <contentRight>
          <ObjectStatus visible="{= !!${/backend} }" text="{= ${/backend} === 'abap' ? 'ABAP connected' : 'Mock data' }" state="{= ${/backend} === 'abap' ? 'Success' : 'Information' }" inverted="true"/>
          <Button icon="sap-icon://refresh" text="Reset demo" press=".onReset" enabled="{= !${/busy} }"/>
        </contentRight>
      </Bar>
    </customHeader>
    <!-- A column: the panes on top, the Traffic panel below them (the panes keep the full height without one). -->
    <VBox class="frBody" renderType="Bare">
    <HBox class="frPanes" renderType="Bare">

      <VBox class="frPane frPane1" renderType="Bare">
        <Title text="1  Disruption"/>
        <MessageStrip text="{/errors/disruption}" type="Error" showIcon="true" visible="{= !!${/errors/disruption} }"/>
        <Label text="Carrier" labelFor="carrier"/>
        <Input id="carrier" value="{/form/carrierId}" maxLength="3" placeholder="LH"/>
        <Label text="Flight number" labelFor="connection"/>
        <Input id="connection" value="{/form/connectionId}" maxLength="4" placeholder="0402"/>
        <Label text="Date" labelFor="date"/>
        <DatePicker id="date" value="{/form/flightDate}" valueFormat="yyyy-MM-dd" displayFormat="d MMM yyyy"/>
        <Label text="Reason" labelFor="reason"/>
        <Input id="reason" value="{/form/reason}" maxLength="100"/>
        <Button text="Cancel flight in ABAP" type="Emphasized" press=".onCancel" enabled="{= !${/busy} }"/>
        <Button text="Replay traffic incident" press=".onReplay" enabled="{= !${/busy} &amp;&amp; !${/replay/running} &amp;&amp; !${/replay/clock} }"/>
        <Text text="{/waiting}" visible="{= !!${/waiting} }" class="sapUiTinyMarginTop"/>
        <Title text="Open disruptions" level="H3" class="sapUiSmallMarginTop"/>
        <List items="{/disruptions}" noDataText="No open disruption" showSeparators="None">
          <CustomListItem type="Active" press=".onSelect">
            <HBox class="frRow" renderType="Bare">
              <VBox>
                <Text text="{label}"/>
                <Label text="{route} · {reason}"/>
              </VBox>
              <Button icon="sap-icon://decline" tooltip="Close disruption" type="Transparent" press=".onClose" enabled="{= !${/busy} }"/>
            </HBox>
          </CustomListItem>
        </List>
      </VBox>

      <VBox class="frPane frPane2" renderType="Bare">
        <Title text="2  Agent"/>
        <MessageStrip text="{/errors/agent}" type="Error" showIcon="true" visible="{= !!${/errors/agent} }"/>
        <VBox id="chat" class="frChat" renderType="Bare">
          <VBox items="{/chat}" renderType="Bare">
            <FormattedText htmlText="{html}" class="frMsg">
              <customData><core:CustomData key="role" value="{role}" writeToDom="true"/></customData>
            </FormattedText>
          </VBox>
          <VBox class="frCard" renderType="Bare" visible="{= !!${/plan} }">
            <Title text="{/plan/title}" level="H4"/>
            <VBox items="{/plan/groups}" renderType="Bare">
              <HBox class="frRow" renderType="Bare">
                <Text text="{= ${count} + (${/disruption/kind} === 'TrafficJam' ? (${count} === 1 ? ' offer' : ' offers') : (${count} === 1 ? ' booking' : ' bookings')) + ' → ' + ${label} }"/>
                <ObjectStatus text="{= ${rebooked} + (${/disruption/kind} === 'TrafficJam' ? ' accepted' : ' moved') }" state="Success" visible="{= ${rebooked} > 0 }"/>
                <ObjectStatus text="{= ${waiting} + ' waiting for reply' }" state="Information" visible="{= ${waiting} > 0 }"/>
              </HBox>
            </VBox>
            <ObjectStatus text="{= ${/plan/unassigned} + ' unassigned' }" state="Warning" visible="{= ${/plan/unassigned} > 0 }"/>
            <VBox items="{/plan/failed}" renderType="Bare">
              <ObjectStatus text="{text}" state="Error"/>
            </VBox>
            <Label text="{/plan/rationale}" wrapping="true"/>
            <HBox visible="{= !!${/plan/waiting} }">
              <Button text="{= ${/disruption/kind} === 'TrafficJam' ? 'Send offers' : 'Approve' }" type="Emphasized" press=".onApprove" enabled="{= !${/busy} }" class="sapUiTinyMarginEnd"/>
              <Button text="Reject" press=".onReject" enabled="{= !${/busy} }"/>
            </HBox>
          </VBox>
          <!-- What the agent said after proposing the plan comes after the card. -->
          <VBox items="{/after}" renderType="Bare">
            <FormattedText htmlText="{html}" class="frMsg">
              <customData><core:CustomData key="role" value="{role}" writeToDom="true"/></customData>
            </FormattedText>
          </VBox>
        </VBox>
        <BusyIndicator text="{/busyText}" visible="{/busy}"/>
        <BusyIndicator text="{/agentBusy}" visible="{= !!${/agentBusy} &amp;&amp; !${/busy} }"/>
        <HBox class="frAsk" renderType="Bare">
          <Input value="{/prompt}" placeholder="Ask the agent" submit=".onAsk" enabled="{= !${/busy} }"/>
          <Button icon="sap-icon://paper-plane" tooltip="Send" type="Emphasized" press=".onAsk" enabled="{= !${/busy} }"/>
        </HBox>
      </VBox>

      <VBox class="frPane frPane3" renderType="Bare">
        <Title text="{= '3  Booking system' + (${/backend} === 'abap' ? ' (ABAP)' : ' (mock)') }"/>
        <MessageStrip text="{/errors/board}" type="Error" showIcon="true" visible="{= !!${/errors/board} }"/>
        <Text text="Cancel a flight or replay a traffic incident to see its route." visible="{= ${/board}.length === 0 }"/>
        <VBox items="{/board}" renderType="Bare">
          <VBox renderType="Bare">
            <HBox class="frRow" renderType="Bare">
              <Text text="{label}"/>
              <ObjectStatus text="{note}" state="{= ${cancelled} ? 'Error' : ${affected} ? 'Warning' : ${free} > 0 ? 'Success' : 'None' }"/>
            </HBox>
            <fr:SeatMap seatsMax="{seatsMax}" seatsBooked="{seatsBooked}" highlighted="{highlighted}" held="{held}" cancelled="{cancelled}"/>
          </VBox>
        </VBox>
        <!-- The legend reuses the control: a one-seat map per dot kind. -->
        <HBox class="frLegend" renderType="Bare">
          <fr:SeatMap seatsMax="1" seatsBooked="1" highlighted="1"/><Label text="affected, at risk or moved"/>
          <fr:SeatMap seatsMax="1" seatsBooked="1"/><Label text="booked"/>
          <fr:SeatMap seatsMax="1" held="1"/><Label text="offered"/>
          <fr:SeatMap seatsMax="1"/><Label text="free"/>
        </HBox>
      </VBox>

    </HBox>
    <!-- The Traffic panel takes the bottom half while there is a replay: clock, controls and chart on the left, the map on the right. -->
    <HBox class="frPane frTraffic" renderType="Bare" visible="{= !!${/replay/clock} }">
      <VBox class="frTrafficInfo" renderType="Bare">
        <Label text="{/replay/label}" wrapping="true"/>
        <HBox class="frTrafficBar" renderType="Bare">
          <ObjectStatus text="{/replay/clockText}" icon="sap-icon://history"/>
          <Button text="{= ${/replay/paused} ? 'Resume' : 'Pause' }" press=".onPause" visible="{/replay/running}" enabled="{= !${/busy} }"/>
          <Button text="Step ▸" tooltip="Play the next sample" press=".onStep" visible="{/replay/running}" enabled="{= !${/busy} &amp;&amp; !!${/replay/paused} }"/>
        </HBox>
        <fr:TrafficChart chart="{/replay/chart}"/>
        <ObjectStatus text="{/replay/report}" state="Warning" visible="{= !!${/replay/report} }"/>
        <Text text="{/replay/note}" visible="{= !!${/replay/note} }"/>
      </VBox>
      <VBox class="frTrafficMap" renderType="Bare">
        <vbm:GeoMap id="map" width="100%" height="100%" mapConfiguration="{/replay/map/config}" refMapLayerStack="DEFAULT"
          centerPosition="{/replay/map/center}" zoomlevel="{/replay/map/zoom}" legendVisible="false" scaleVisible="false">
          <vbm:vos>
            <vbm:Routes items="{path: '/replay/map/routes', templateShareable: false}">
              <vbm:items><vbm:Route position="{position}" color="RGB(187,0,0)" linewidth="6"/></vbm:items>
            </vbm:Routes>
            <vbm:Spots items="{path: '/replay/map/spots', templateShareable: false}">
              <vbm:items><vbm:Spot position="{position}" text="{label}" tooltip="{label}" type="{type}"/></vbm:items>
            </vbm:Spots>
          </vbm:vos>
        </vbm:GeoMap>
      </VBox>
    </HBox>
    </VBox>
  </Page>
</mvc:View>
